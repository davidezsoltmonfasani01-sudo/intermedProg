<fmt:parseDate value="2026-03-23 14:30:00" pattern="yyyy-MM-dd HH:mm:ss" var="dateTime_oggi" scope="application" />
<!DOCTYPE html>
<html lang="it">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Ambulatorio Dietologia L'Ultima Cena</title>
    <link rel="stylesheet" href="style.css">
  </head>

  <body bgcolor="#f1f5f4">
    <table width="100%" height="100%" border="0" cellpadding="0" cellspacing="0" bgcolor="#f1f5f4">
      <thead id="sticky-header">
        <tr>
          <td colspan="2" bgcolor="#176b63">
            <table width="100%" border="0" cellpadding="16" cellspacing="0">
              <tr>
                <td width="100" align="left">
                  <a href="index.jsp">
                    <img  style="width: 280px; height: 116px;"
                    src="panda.png"
                    title="Universita' di Pavia"
                    alt="Logo Universita' di Pavia" id="logo">
                  </a>
                </td>
                <td>
                </td>
                <td>
                </td>
                <td>
                </td>
                <td>
                </td>
                <td>
                </td>
                <td align="left">

                  <h1 class="title">Ambulatorio Dietologia</h1>
                  <p  class="title"><em>L'Ultima Cena</em> Cura, ascolto e benessere</p>

                </td>
                <c:if test="${not empty user}">
                  <sql:query var="CountNotifiche">
                    SELECT count(*) AS CountNotifiche
                    FROM Notifiche n
                    WHERE n.ID_utente = ?
                    AND  n.ID_stato = '11'
                    <sql:param value="${user.ID}" />
                  </sql:query>
                  <c:set var="CountNotifiche" value="${CountNotifiche.rows[0].CountNotifiche}" />

                  <td>

                    <a href="notifiche.jsp">
                      <table width="100%" border="0" cellpadding="0" cellspacing="0">
                        <tr>
                          <td align="center">
                            <img width="40" height="40"
                            src="notifiche.svg"
                            title="Notifiche"
                            alt="Notifiche" id="notifiche">

                          </td>
                        </tr>
                        <tr>
                          <td align="center">
                            <p  class="rmsg">${CountNotifiche}</p>
                          </td>
                        </table>
                      </a>
                    </td>
                  </c:if>
                </tr>
              </table>
            </td>
          </tr>
          <tr>
            <td colspan="2" bgcolor="#124f49" style="padding: 0;">
              <nav class="menu-contenitore" aria-label="Navigazione principale">
                <div class="menu-links">
                  <div class="menu-scrollabile">
                    <c:if  test="${not empty user}">
                      <a href="dispatch_home.jsp" >
                        <img  class="img-btn"
                        src="home.svg"
                        title="home"
                        alt="Home">
                      </a>
                    </c:if>
                    <c:choose>
                      <c:when  test="${user.ruolo == 'PZ'}">
                        <c:choose>
                          <c:when test="${ user.ID_stato == 2}">
                            <sql:query var="visite">
                              SELECT count(*) as n_visite
                              FROM Visite v
                              INNER JOIN Prenotazioni p ON p.ID_prenotazione = v.ID_prenotazione
                              WHERE p.ID_pz = ?
                              <sql:param value="${user.ID}"/>
                            </sql:query>

                            <a href="kc_associato.jsp">Kitchen Coach</a>
                            <a href="lista_schede_professionali_mn.jsp">Elenco Medici Nutrizionisti</a>
                            <a href="lista_schede_professionali_kc.jsp">Elenco Kitchen Coach</a>
                            <c:if test= "${visite.rows[0].n_visite >0}">
                              <a href="lista_visite.jsp">Elenco Visite</a>
                              <a href="pagina_diario.jsp">Diario Alimentare</a>
                            </c:if>
                          </c:when>
                          <c:when test="${ user.ID_stato == 3}">
                            <a href="lista_schede_professionali_mn.jsp">Elenco Medici Nutrizionisti</a>
                            <a href="lista_schede_professionali_kc.jsp">Elenco Kitchen Coach</a>
                          </c:when>
                          <c:otherwise>

                          </c:otherwise>
                        </c:choose>

                      </c:when>
                      <c:when  test="${user.ruolo == 'KC'}">
                        <a href="lista_pazienti.jsp">Lista Dei Pazienti</a>
                        <a href="compilazione_scheda_professionale.jsp">Modifica Scheda Professionale</a>
                      </c:when>
                      <c:when  test="${user.ruolo == 'MN'}">
                        <a href="lista_visite.jsp" >Elenco Visite</a>
                        <a href="lista_prenotazioni.jsp" >Elenco Prenotazioni</a>
                        <a href="compilazione_scheda_professionale.jsp" >Scheda Professionale</a>
                        <a href="logout.jsp" >Logout</a>
                      </c:when>
                      <c:when  test="${user.ruolo == 'DS'}">
                        <a href="statistiche.jsp" >Statistiche</a>
                        <a href="lista_utenti.jsp" >Lista Utenti</a>
                        <a href="lista_richieste_pz.jsp" >Richieste Attivazione</a>
                        <a href="registrazione_collaboratori.jsp" >Registra collaboratori</a>
                        <a href="lista_associazioni.jsp" >Lista associazioni</a>
                      </c:when>
                      <c:otherwise>
                        <a href="dispatch_home.jsp" >Login</a>
                        <a href="registrazione_pz.jsp" >Registrati</a>
                      </c:otherwise>
                    </c:choose>
                  </div>
                  <c:if  test="${not empty user}">
                    <div>
                      <a href="logout.jsp" >
                        <img  class="img-btn"
                        src="LogOut.svg"
                        title="log out"
                        alt="logout">
                      </a>
                    </div>
                  </c:if>
                </div>
              </nav>
            </td>
          </tr>
        </thead>